# ============================================================
# HomeStack Global Configuration
# Generated by setup.sh — edit paths if you move the install
# ============================================================

# Installation directory (auto-detected by CLI, but used for compose paths)
HOMESTACK_DIR=/homestack

# Data directories
APPDATA=/homestack/AppData
BACKUPS=/homestack/Backups
MEDIA=/homestack/Media

# Timezone
TZ=Europe/Bratislava

# User/Group IDs (match your host user)
PUID=1000
PGID=1000
DOCKER_USER=1000:1000
