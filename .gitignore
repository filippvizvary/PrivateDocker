# ============================================================
# HomeStack .gitignore
# ============================================================

# Runtime data (Docker volumes — large, user-specific)
/AppData/
/Backups/
/Media/

# App catalog cache (fetched from homestack-apps repo)
.cache/

# SQLite database (generated at runtime)
homestack.db

# Per-app secrets (generated at install time)
installed/*/secrets.env

# Lock file
.lock

# Docker runtime
docker-compose.override.yml

# OS files
.DS_Store
Thumbs.db

# Editor / IDE files
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log
/Projects/
/Scripts/
/script.sh