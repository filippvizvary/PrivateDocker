# HomeStack unattended bootstrap environment
# Copy to /etc/homestack/bootstrap.env on target host (mode 0600)

# Required for CLI access on first boot (must exist as Debian installer-created user)
HOMESTACK_REAL_USER=filip

# Noninteractive setup behavior
NONINTERACTIVE=1
HOMESTACK_SETUP_EXISTING=fail
HOMESTACK_RECONFIGURE=0

# Optional install overrides
HOMESTACK_DIR=/homestack
TZ=UTC
# PUID=1000
# PGID=1000
# HOMESTACK_APPS_REPO=https://github.com/filippvizvary/homestack-apps.git

# Optional source override (pin a branch/tag/commit via archive or local mirror)
HOMESTACK_REPO_URL=https://github.com/filippvizvary/homestack.git
