#!/bin/bash
# HomeStack — CLI shim
# Activates the Python venv and delegates to the Click CLI.
set -euo pipefail

# Resolve HomeStack root directory — follow symlinks to find real install path
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HOMESTACK_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export HOMESTACK_DIR

VENV="${HOMESTACK_DIR}/.venv"

if [[ ! -d "$VENV" ]]; then
  echo "Error: Python virtual environment not found at ${VENV}"
  echo "Run setup.sh to install HomeStack."
  exit 1
fi

exec "${VENV}/bin/python" -m homestack "$@"
